# ---------------------------------------------------------------------------
# فایل نمونه — کپی کن به .env و مقادیر واقعی را جایگزین کن.
# .env هرگز نباید commit شود (در .gitignore هست).
#
# نکته‌ی Railway: اگر روی Railway دیپلوی می‌کنی، این فایل را کپی نمی‌کنی —
# مقادیر را مستقیم در Railway → Variables وارد می‌کنی. برای DATABASE_URL
# از "Add a Variable Reference" سرویس Postgres استفاده کن، نه کپی دستی
# (راهنمای کامل در RAILWAY.md).
# ---------------------------------------------------------------------------

# --- دیتابیس ---
# در docker-compose.yml مقدار واقعی از DB_PASSWORD ساخته می‌شود؛ این خط
# فقط برای اجرای لوکال (npm run dev بدون Docker) لازم است.
DATABASE_URL="postgresql://batterybot:changeme_dev_password@localhost:5432/battery_bot"
DB_PASSWORD=changeme_dev_password

# --- بات تلگرام ---
# توکن از @BotFather گرفته می‌شود.
TELEGRAM_BOT_TOKEN=

# رشته‌ی تصادفی دلخواه (مثلاً با `openssl rand -hex 32` بساز) — برای
# تایید این‌که درخواست واقعاً از تلگرام آمده، نه یک فراخوانی جعلی به آدرس
# وب‌هوک. باید هنگام setWebhook هم همین مقدار فرستاده شود (scripts/set-webhook.ts).
TELEGRAM_WEBHOOK_SECRET=

# آدرس عمومی سرور (بعد از راه‌اندازی Nginx+SSL) — برای ثبت وب‌هوک لازم است.
# مثال: https://battery-bot.example.com
PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# متغیرهای فاز ۱ (STT/Vision) — فعلاً خالی بمانند، در فاز ۱ تکمیل می‌شوند.
# از همین حالا اینجا نوشته شده‌اند تا ساختار فایل در فاز ۱ عوض نشود.
# ---------------------------------------------------------------------------

# --- ارائه‌دهنده‌ی STT (صوت→متن) ---
# مقدار: "groq" یا در آینده "openrouter" (طبق AI Provider Adapter در ARCHITECTURE.md)
STT_PROVIDER=groq
GROQ_API_KEY=

# --- ارائه‌دهنده‌ی Vision ---
# مقدار: "gemini" یا در آینده "openrouter"
VISION_PROVIDER=gemini
GEMINI_API_KEY=

# --- در صورت نیاز به مسیر جایگزین (fallback) از طریق 9router/OpenRouter ---
OPENROUTER_API_KEY=
